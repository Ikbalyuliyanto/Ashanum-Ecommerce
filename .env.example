# Copy to .env for local development. In production these go in
# /etc/ecommerce/ecommerce.env (read by systemd). Never commit real secrets.
# Comments must be on their own line: systemd does not support inline comments.

# --- Application (Phase 1) ---
# development | production
APP_ENV=development
# Keep 127.0.0.1 in production: only Nginx may reach the app.
APP_HOST=127.0.0.1
APP_PORT=8080
APP_NAME=Ashanum
# Public URL of the site (no trailing slash). Payment providers send buyers
# back to it. Empty in development: http://APP_HOST:APP_PORT is used.
# Required (https) in production when payments are enabled.
APP_BASE_URL=

# --- PostgreSQL remote (Phase 1) ---
# Use sslmode=require (or verify-full) for a database on another server.
# Session settings can be appended as parameters, e.g. &statement_timeout=10000
DATABASE_URL=postgres://ecommerce:password@db.example.com:5432/ecommerce?sslmode=require
DB_MAX_CONNS=10
DB_MIN_CONNS=1

# --- Session (Phase 2) ---
# Required in production, at least 32 characters, e.g. `openssl rand -base64 48`.
# Left empty in development, a random secret is used and sessions end on restart.
SESSION_SECRET=

# --- Google OAuth (not implemented yet) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMTP / email for password reset (not implemented yet) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- Cloudinary (Phase 3) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Midtrans (Phase 6) ---
# Sandbox only: order totals do not include shipping cost yet, so production
# payments must stay off until shipping integration and a production
# payment review are done. Any other value is refused at startup.
MIDTRANS_ENV=sandbox
# Sandbox server key (SB-Mid-server-...). Backend only: never rendered,
# logged or stored in the database. Empty disables online payment.
MIDTRANS_SERVER_KEY=
# Not used: Snap runs in redirect mode, so no Midtrans script or client key
# is needed in the browser. Kept for a possible Snap popup integration.
MIDTRANS_CLIENT_KEY=
