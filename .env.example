# Copy to .env for local development. In production these go in
# /etc/ecommerce/ecommerce.env (read by systemd). Never commit real secrets.
# Comments must be on their own line: systemd does not support inline comments.

# --- Application (Phase 1) ---
# development | production
APP_ENV=development
# Keep 127.0.0.1 in production: only Nginx may reach the app.
APP_HOST=127.0.0.1
APP_PORT=8080
APP_NAME=Ashanum
# Public URL of the site (no trailing slash). Payment providers send buyers
# back to it. Empty in development: http://APP_HOST:APP_PORT is used.
# Required (https) in production when payments are enabled.
APP_BASE_URL=

# --- PostgreSQL remote (Phase 1) ---
# Use sslmode=require (or verify-full) for a database on another server.
# Session settings can be appended as parameters, e.g. &statement_timeout=10000
DATABASE_URL=postgres://ecommerce:password@db.example.com:5432/ecommerce?sslmode=require
DB_MAX_CONNS=10
DB_MIN_CONNS=1

# --- Session (Phase 2) ---
# Required in production, at least 32 characters, e.g. `openssl rand -base64 48`.
# Left empty in development, a random secret is used and sessions end on restart.
SESSION_SECRET=

# --- Google OAuth (not implemented yet) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMTP / email for password reset (not implemented yet) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- Returns (Phase 7) ---
# Days after an order is completed during which the buyer may request a
# return. A business policy, not a fixed rule.
RETURN_WINDOW_DAYS=7

# --- Admin / inventory (Phase 8) ---
# A variant with 1..N units left counts as "stok rendah" on the admin
# dashboard and reports (no notification is sent).
LOW_STOCK_THRESHOLD=5

# --- REST API for mobile apps (Phase 9) ---
# Bearer access token and rotating refresh token lifetimes (Go durations
# such as 15m / 720h, or whole days such as 30d).
API_ACCESS_TOKEN_TTL=15m
API_REFRESH_TOKEN_TTL=30d
# Browser origins allowed to call /api/v1 (comma separated, exact origins,
# never *). Empty = no CORS headers: native mobile apps do not need CORS.
API_CORS_ALLOWED_ORIGINS=
# Where Midtrans sends the buyer back after paying from the app: an app
# link or custom scheme; {order_number} is replaced. Empty = web finish
# page. Set by the server only; clients cannot choose a redirect.
API_PAYMENT_FINISH_URL=

# --- Shipping / Biteship (Phase 10) ---
# Only provider for now: biteship. Without BITESHIP_API_KEY shipping is off:
# checkout says the shipping cost cannot be calculated and no order can be
# placed (an order never falls back to shipping cost 0).
SHIPPING_PROVIDER=biteship
# Backend only: never rendered, sent to apps, logged or committed.
# BITESHIP_ENV=test needs a biteship_test.* key (testing mode, no real pickup).
BITESHIP_API_KEY=
BITESHIP_ENV=test
# BITESHIP_ENV=live (real pickups and charges) is refused unless this is
# true. Keep false until the whole flow was tested with a testing key.
SHIPPING_LIVE_ENABLED=false
# Webhook https://<APP_BASE_URL>/webhooks/shipping/biteship: set the same
# header name and secret (24+ characters) as "Headers Signature Key/Secret"
# in the Biteship dashboard. Empty secret = notifications are refused.
BITESHIP_WEBHOOK_HEADER=X-Ashanum-Webhook-Secret
BITESHIP_WEBHOOK_SECRET=
# Local testing only (development): a fake Biteship API. Empty = official API.
BITESHIP_BASE_URL=
# Shop address where the courier picks parcels up (required with a key).
SHIP_FROM_NAME=
SHIP_FROM_PHONE=
SHIP_FROM_ADDRESS=
SHIP_FROM_POSTAL_CODE=
# Optional: Biteship area id of the shop (from the area search) and coordinates.
SHIP_FROM_AREA_ID=
SHIP_FROM_LATITUDE=
SHIP_FROM_LONGITUDE=
# Courier codes offered at checkout (comma separated).
SHIPPING_COURIERS=jne,sicepat,jnt,anteraja,pos
# Provider rates reused for the same route and weight (5m–15m), and how long
# a shipping cost shown at checkout stays valid for ordering (5m–2h).
SHIPPING_RATE_CACHE_TTL=10m
SHIPPING_QUOTE_TTL=30m

# --- Cloudinary (Phase 3) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Midtrans (Phase 6) ---
# Sandbox only: production payments stay off until the real Midtrans sandbox
# and shipping are tested end to end and a production payment review is
# done. Any other value is refused at startup. orders.total (items +
# shipping) is the only amount ever charged.
MIDTRANS_ENV=sandbox
# Sandbox server key (SB-Mid-server-...). Backend only: never rendered,
# logged or stored in the database. Empty disables online payment.
MIDTRANS_SERVER_KEY=
# Not used: Snap runs in redirect mode, so no Midtrans script or client key
# is needed in the browser. Kept for a possible Snap popup integration.
MIDTRANS_CLIENT_KEY=
